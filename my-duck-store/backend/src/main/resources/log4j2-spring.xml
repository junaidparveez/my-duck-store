<?xml version="1.0" encoding="UTF-8"?>
<!--
  Log4j2 configuration for My Duck Store.

  Spring Boot loads this file first (the -spring suffix lets Spring control
  the lifecycle so profile-based log levels work). The monitorInterval means
  changes are picked up at runtime without restarting.

  Levels in brief:
    com.myduckstore  DEBUG  — every service and controller call is visible during dev
    org.hibernate.SQL        DEBUG  — shows the actual SQL queries
    org.springframework.web  INFO   — request mapping noise suppressed
    root                     INFO   — everything else at INFO
-->
<Configuration status="WARN" monitorInterval="30">

    <Properties>
        <!-- Colorised pattern for the console. Dim the timestamp, brighten the level. -->
        <Property name="CONSOLE_PATTERN">
            %d{HH:mm:ss.SSS} %highlight{%-5level}{FATAL=red bold, ERROR=red, WARN=yellow bold, INFO=green, DEBUG=cyan, TRACE=white} [%15.15t] %style{%-40.40c{1.}}{dim} : %msg%n%throwable
        </Property>
        <!-- Plain pattern for the rolling log file — no ANSI codes. -->
        <Property name="FILE_PATTERN">
            %d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %c{1} : %msg%n%throwable
        </Property>
        <Property name="LOG_DIR">logs</Property>
    </Properties>

    <Appenders>

        <!-- ── Console ─────────────────────────────────────────────────────── -->
        <Console name="Console" target="SYSTEM_OUT" follow="true">
            <PatternLayout pattern="${CONSOLE_PATTERN}" disableAnsi="false"/>
        </Console>

        <!-- ── Rolling file ────────────────────────────────────────────────── -->
        <!-- Rolls daily and when a single file exceeds 10 MB; keeps 30 days. -->
        <RollingFile name="RollingFile"
                     fileName="${LOG_DIR}/duck-store.log"
                     filePattern="${LOG_DIR}/duck-store-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${FILE_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>

    </Appenders>

    <Loggers>

        <!-- Application code — DEBUG so every service/repo call is visible. -->
        <Logger name="com.myduckstore" level="DEBUG" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Logger>

        <!-- Show the actual SQL Hibernate sends to the database. -->
        <Logger name="org.hibernate.SQL" level="DEBUG" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Logger>

        <!-- Bind parameter values alongside the SQL (TRACE = very verbose). -->
        <Logger name="org.hibernate.orm.jdbc.bind" level="TRACE" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Logger>

        <!-- Spring MVC request handling — INFO is enough. -->
        <Logger name="org.springframework.web" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Logger>

        <!-- Flyway migration progress. -->
        <Logger name="org.flywaydb" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Logger>

        <!-- Springdoc / Swagger bootstrap is INFO-chatty; keep it quiet. -->
        <Logger name="org.springdoc" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Logger>

        <!-- Catch-all root logger. -->
        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Root>

    </Loggers>

</Configuration>
